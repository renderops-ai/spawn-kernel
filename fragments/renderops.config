# RenderOps changes on top of the base config in configs/<arch>/<version>.config.
# Same format as a kernel .config. Applied with scripts/kconfig/merge_config.sh,
# and build.sh fails if olddefconfig drops or changes any line below.

# `uname -r` inside a sandbox reports 6.1.182-renderops, so our kernel is
# distinguishable from upstream or Firecracker CI builds.
CONFIG_LOCALVERSION="-renderops"

# Firecracker before v1.8 has no ACPI: it announces virtio devices (disks,
# network, vsock) on the kernel command line (virtio_mmio.device=...). Without
# this the guest finds no devices and never boots. E2B's base config leaves it
# off because their Firecracker uses ACPI. ACPI stays on: under v1.7 it finds no
# tables and disables itself. Which Firecracker versions a kernel really works
# with is decided by scripts/boot-test.sh, per runtime.
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

# Firecracker before v1.8 also describes the vCPUs in an MP table (MPTable), not
# ACPI. Without this the guest only brings up the boot CPU: every sandbox ran on
# one CPU whatever its size (build 3). E2B's base config turns it off because
# their Firecracker describes CPUs in ACPI.
CONFIG_X86_MPPARSE=y
