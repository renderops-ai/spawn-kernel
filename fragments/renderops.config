# RenderOps changes on top of the base config in configs/<arch>/<version>.config.
# Same format as a kernel .config. Applied with scripts/kconfig/merge_config.sh,
# and build.sh fails if olddefconfig drops or changes any line below.

# `uname -r` inside a sandbox reports 6.1.182-renderops, so our kernel is
# distinguishable from upstream or Firecracker CI builds.
CONFIG_LOCALVERSION="-renderops"
